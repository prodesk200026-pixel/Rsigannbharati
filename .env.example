# ============================================================
# Copy this to ".env" for local testing, OR paste into Render ->
# your service -> Environment. NEVER commit a real .env to GitHub
# (this file, once you fill it with real secrets, is private —
# don't share this zip around either, since your VAPID keys below
# are already real values).
# ============================================================

# --- Broker priority: candles are tried on PRIMARY first, then
#     SECONDARY if the primary fails or returns nothing. Option
#     chain / straddle / IV always come from Dhan regardless of
#     this order — Angel One has no native option-chain endpoint. ---
PRIMARY_BROKER=ANGEL
SECONDARY_BROKER=DHAN

# --- Angel One SmartAPI ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# --- Dhan v2 ---
# Client ID + PIN + TOTP secret auto-generates and auto-refreshes the
# access token daily (Dhan's confirmed /app/generateAccessToken flow).
# You need TOTP enabled on your Dhan account first (Dhan Web -> Profile
# -> DhanHQ Trading APIs -> enable TOTP) to get a TOTP secret.
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
# Alternative: paste a token generated by hand on web.dhan.co instead of
# the three lines above. If this is set, it's used directly.
# DHAN_ACCESS_TOKEN=

# --- Push notifications ---
VAPID_PUBLIC_KEY=BL3mZnq-NjGPH-Tp4FN3cOZtFUobH2ghOvQtA7Kq0XZA5ogz6GhaLVoqCUczRF_68H9QO-HALBj2v_VuLelK1QE
VAPID_PRIVATE_KEY=_CCCpxaTtsSPHAUyNQafWm0N95vqXzPfe_kB16ji2Ck
VAPID_SUBJECT=mailto:you@example.com

# --- Server ---
PORT=10000
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Optional ---
API_SECRET=
TRACK_INDICES=NIFTY,SENSEX,FINNIFTY
POLL_INTERVAL_SECONDS=15
DHAN_RENEW_EVERY_HOURS=20
MARKET_HOURS_ONLY=true
